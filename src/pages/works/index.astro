---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import NightBlock from '../../components/NightBlock.astro';
import Icon from '../../components/Icon.astro';
import type { Topic } from '../../lib/icon-topics';
import { getWorks, getSeries, getCharacters, getGear, characterName, filterKey, keysOf, KIND_LABEL, label, pathOf } from '../../lib/cms';
import type { Track, WorkKind } from '../../lib/types';

const works = await getWorks();
const count = (pred: (w: (typeof works)[number]) => boolean) => works.filter(pred).length;
const series = await getSeries();
const kinds: WorkKind[] = ['original', 'tribute'];
const characters = await getCharacters();
const artists = [...new Map(works.flatMap((w) => w.music).map((t) => [t.id, t] as [string, Track])).values()];
const gear = await getGear();

// The four groups of the site (Work / Character / Music / Gear), plus Series once there is more than one.
// A button that would show every work (or none) is left out: it would not narrow anything.
// name: brand and artist names keep their own capitals.
const groups = [
  { title: 'Series', icon: 'series' as Topic, items: series.map((s) => ({ key: filterKey.series(s), label: s.name, n: count((w) => w.series.id === s.id) })) },
  { title: 'Work', icon: 'works' as Topic, items: kinds.map((k) => ({ key: filterKey.kind(k), label: KIND_LABEL[k], n: count((w) => w.kind === k) })) },
  { title: 'Character', icon: 'character' as Topic, items: characters.map((c) => ({ key: filterKey.character(c), label: characterName(c), n: count((w) => w.character?.id === c.id) })) },
  { title: 'Music', icon: 'music' as Topic, name: true, items: artists.map((t) => ({ key: filterKey.music(t), label: t.artist, n: count((w) => w.music.some((x) => x.id === t.id)) })) },
  { title: 'Gear', icon: 'gear' as Topic, name: true, items: gear.map((g) => ({ key: filterKey.gear(g), label: `${g.brand} ${g.model}`, n: count((w) => w.gear.some((x) => x.id === g.id)) })) },
]
  .map((g) => ({ ...g, items: g.items.filter((it) => it.n > 0 && it.n < works.length) }))
  .filter((g) => g.items.length);
// first paint (no JavaScript): the same rhythm the filter script applies
const RHYTHM = ['w-center', 'w-pair-a', 'w-pair-b', 'w-bleed-right', 'w-center', 'w-pair-a', 'w-pair-b', 'w-bleed-left'];
const layoutOf = (i: number) => {
  const cls = works.length === 2 ? ['w-pair-a', 'w-pair-b'][i] : RHYTHM[i % RHYTHM.length];
  return cls === 'w-pair-a' && i === works.length - 1 ? 'w-solo' : cls;
};

const base = Astro.site!.href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Works｜NE0NNi*', url: new URL('/works/', base).href,
  hasPart: works.map((w) => ({ '@type': 'VisualArtwork', name: `${label(w)} ${w.series.name}`, url: new URL(pathOf(w), base).href })),
};
---
<Base title="Works" description="NE0NNi*（ネオンニ）の作品一覧。シリーズ HEADPHONES GIRL の作品を、号数順に掲載しています。Original／Tribute、キャラクター、曲のアーティスト、描いたギアで絞り込めます。" current="works" jsonLd={jsonLd}>

  <header class="page-head l-container">
    <div class="l-grid page-head__grid">
      <h1 class="t-display-1 page-head__title with-icon with-icon--display"><Icon topic="works" size="display" />Works</h1>
      <div class="page-head__lead">
        <p class="t-body">号数は、シリーズをまたいだ公開順の通し番号です。Work・Character・Music・Gear で絞り込めます。</p>
      </div>
    </div>
  </header>

  <section class="l-section l-container works" aria-label="作品一覧">
    <div class="filter-bar">
      <div class="filter" role="group" aria-label="作品の絞り込み" data-filter>
        <div class="filter__group filter__group--all">
          <button class="filter__btn t-label" type="button" aria-pressed="true" data-key="all">All<span class="filter__count">{works.length}</span></button>
        </div>
        {groups.map((g) => (
          <div class="filter__group">
            <span class="filter__title t-label with-icon with-icon--slot" aria-hidden="true"><Icon topic={g.icon} size="label" />{g.title}</span>
            <span class="filter__items">
              {g.items.map((it) => (
                <button class:list={['filter__btn t-label', g.name && 'is-name']} type="button" aria-pressed="false" data-key={it.key} aria-label={`${g.title}：${it.label}（${it.n}）`}>{it.label}<span class="filter__count">{it.n}</span></button>
              ))}
            </span>
          </div>
        ))}
      </div>
      <p class="t-label works__count" aria-live="polite"><span data-count>{works.length}</span> works</p>
    </div>

    <div class="works__grid l-grid" data-works>
      <div class="v-slot" aria-hidden="true"><span class="v-word t-grotesk-display">Works</span></div>
      {works.map((w, i) => (
        <article class:list={['wcard', layoutOf(i)]} data-keys={keysOf(w).join(' ')}>
          <a class="wcard__link" href={pathOf(w)}>
            <div class="wcard__art">
              <Art img={w.key} sizes="(min-width: 1200px) 50vw, (min-width: 768px) 75vw, 100vw" style={w.focus ? `object-position:${w.focus}` : undefined} />
            </div>
            <div class="wcard__cap">
              <span class="t-number">{label(w)}</span>
              <span class="t-grotesk-title">{w.series.name}</span>
              <span class="t-label wcard__kind">{KIND_LABEL[w.kind]}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <NightBlock to="about" />
</Base>

<style>
  .filter-bar { display: grid; gap: var(--space-4); margin-bottom: var(--block-gap); }
  /* one row per group: the group's name, then its buttons */
  .filter { display: grid; gap: var(--space-3); }
  .filter__group { display: grid; gap: var(--space-2); align-items: center; }
  .filter__items { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  @media (min-width: 768px) {
    .filter__group { grid-template-columns: 112px minmax(0, 1fr); column-gap: var(--space-3); }
    .filter__group--all { grid-template-columns: none; justify-items: start; }
  }
  .works__count span { font-variant-numeric: tabular-nums; }
  @media (min-width: 768px) { .filter-bar { grid-template-columns: 1fr auto; align-items: end; } }

  .works__grid { row-gap: var(--block-gap); align-items: start; }
  .v-slot { display: none; }
  @media (min-width: 1200px) { .v-slot { display: block; grid-column: 12; grid-row: 1 / span 2; justify-self: end; } }
  .wcard[hidden] { display: none; }
  .wcard__link { display: block; text-decoration: none; }
  .wcard__art { overflow: hidden; aspect-ratio: 4 / 5; }
  .wcard :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-3) var(--ease-out); }
  .wcard__link:hover :global(img) { transform: scale(1.03); }
  .wcard__cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); margin-top: var(--space-3); }
  .wcard__kind { margin-left: auto; }
  .wcard.w-bleed-right .wcard__art, .wcard.w-bleed-left .wcard__art { aspect-ratio: 4 / 3; }
  .wcard.w-bleed-right .wcard__cap { padding-right: var(--grid-margin); }
  .wcard.w-bleed-left .wcard__cap { padding-left: var(--grid-margin); }
</style>
