---
import Base from '../../layouts/Base.astro';
import Go from '../../components/Go.astro';
---
<Base title="お問い合わせを受け付けました" description="NE0NNi（ネオンニ）へのお問い合わせを受け付けました。" current="contact">
  <section class="page-head l-container thanks">
    <div class="l-grid page-head__grid">
      <h1 class="t-display-1 page-head__title">Thank you</h1>
      <div class="page-head__lead">
        <p class="t-body">お問い合わせを受け付けました。内容を確認のうえ、ご入力のメールアドレスにご連絡します。</p>
        <Go href="/works/" label="View all works" />
      </div>
    </div>
  </section>
</Base>
<style>
  .thanks { padding-bottom: var(--section-gap); }
  .thanks .page-head__lead { justify-items: start; }
</style>
