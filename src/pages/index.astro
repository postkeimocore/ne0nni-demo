---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Lockup from '../components/Lockup.astro';
import WorkList from '../components/WorkList.astro';
import Chapter from '../components/Chapter.astro';
import WorkData from '../components/WorkData.astro';
import Go from '../components/Go.astro';
import Icon from '../components/Icon.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { getSite, getWorks, KIND_LABEL, label, pathOf, stackPictures } from '../lib/cms';
import { ACCOUNTS } from '../lib/sns';

const site = await getSite();
const { latest } = site;
const works = await getWorks();
// the chapters show each work's lettered creative (2026-11-13, the user)
const tall = (w: (typeof latest)[number]) => w.lettered!.height / w.lettered!.width > 1.5;
const sizes = (w: (typeof latest)[number]) => (tall(w) ? '(min-width: 1200px) 33vw, (min-width: 768px) 45vw, 100vw' : '(min-width: 1200px) 50vw, (min-width: 768px) 60vw, 100vw');
// the hero's wall pattern: rings round the head (radii in the rings' own units)
const RINGS = Array.from({ length: 10 }, (_, i) => 96 + i * 82);
// the HOME chapters take turns: art left / art right / the cutout bleeding off the right edge
const LOOKS = ['a', 'b', 'c'] as const;

const url = Astro.site!.href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'NE0NNi*', alternateName: 'ネオンニ', url, inLanguage: 'ja' },
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'NE0NNi*', alternateName: 'ネオンニ', url,
    logo: new URL('/assets/logo.svg', url).href, sameAs: ACCOUNTS.map((a) => a.url),
  },
];
---
<Base description={site.description} home jsonLd={jsonLd}>

  <!-- HERO: the NE0NNi* lockup stuck on the page like a sticker. Its look and motion come from the wakabayashi site
       (2026-11-12); the ground, the header and the type are this site's (design-system.md 5 ヒーロー) -->
  <section class="cover hero" aria-labelledby="home-h">
    <div class="hero__stage">
      <div class="hero__wall" aria-hidden="true"></div>
      <h1 class="u-sr" id="home-h">NE0NNi*（ネオンニ） Girls &amp; night sounds.</h1>
      <div class="hero__lockup">
        <svg class="hero__rings" viewBox="-900 -900 1800 1800" aria-hidden="true">
          {RINGS.map((r, i) => <circle r={r} style={`--i:${i}`} />)}
        </svg>
        <div class="hero__sticker"><Lockup /></div>
      </div>
      <p class="hero__tag hero__tag--bl t-grotesk-data">Girls &amp; night sounds.</p>
      <p class="hero__tag hero__tag--br t-grotesk-data" aria-hidden="true">NE0NNi*</p>
      <SnsIcons class="hero__sns" />
    </div>
  </section>

  <!-- WORKS: the list of every work, then the newest three works with a lettered creative as chapters, in order of number, threaded on one cable (4-2) -->
  <section class="l-section l-mist l-container home-works" aria-labelledby="works-h" data-glints="day">
    <div class="home-works__head l-grid">
      <h2 class="t-display-2 home-works__title with-icon with-icon--display" id="works-h"><Icon topic="works" size="display" />Works</h2>
    </div>

    <!-- every work: the newest large, the rest in two columns (arrangement from the wakabayashi site, cards this site's) -->
    <WorkList works={works} />

    <div class="looks" data-cable>
      <span class="looks__start" data-cable-point="center" aria-hidden="true"></span>
      {latest.map((w, i) => {
        const look = LOOKS[i % LOOKS.length];
        const art = w.lettered!;
        return (
          <article class:list={['look', `look--${look}`, tall(w) && 'is-tall']} aria-labelledby={`look-${w.id}`}>
            <Chapter no={label(w)} title={w.series.name} id={`look-${w.id}`} tag="h3">
              <span class="t-label">{KIND_LABEL[w.kind]}</span>
            </Chapter>
            <div class="look__body l-grid">
              <a class="look__art" href={pathOf(w)} tabindex="-1" aria-hidden="true" data-cable-point="center">
                <div class="stack" data-stack style={`aspect-ratio:${art.width}/${art.height}`}>
                  {stackPictures(w, art).map((o) => <div class="stack__layer" aria-hidden="true"><Art img={o} sizes={sizes(w)} decorative style={o.focus ? `object-position:${o.focus}` : undefined} /></div>)}
                  <Art img={art} sizes={sizes(w)} decorative />
                </div>
              </a>
              <div class="look__info" data-reveal="up">
                <WorkData work={w} />
                <Go href={pathOf(w)} label={`View ${label(w)}`} />
              </div>
            </div>
          </article>
        );
      })}
      <p class="home-works__more" data-cable-point="top">
        <Go href="/works/" label="View all works" />
      </p>
    </div>
  </section>

  <!-- ABOUT: the one black section of HOME (Wedding MESSAGE) -->
  <section class="l-section l-container is-night home-about" aria-labelledby="about-h" data-glints="night">
    <div class="home-about__head">
      <h2 class="t-display-1" id="about-h" data-reveal="chars">About</h2>
      <span class="ast is-twinkle" style="--size:40px" aria-hidden="true"></span>
    </div>
    <div class="l-grid">
      <div class="home-about__body">
        <p class="t-display-3">Girls &amp; night sounds.</p>
        <p class="t-statement">音楽を聴く女の子を描く<br>イラストレーション。</p>
        <p class="t-body">NE0NNi*（ネオンニ）は、人物と表情、装い、音楽を聴いている時間を描いています。シリーズ HEADPHONES GIRL では、作品ごとに、キャラクターと曲、描いたヘッドホンなどのギアを記録しています。</p>
        <SnsIcons handles />
        <Go href="/about/" label="About NE0NNi*" />
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="l-section l-container home-contact" aria-labelledby="contact-h">
    <div class="l-grid home-contact__grid">
      <h2 class="t-display-2 home-contact__title with-icon with-icon--display" id="contact-h"><Icon topic="contact" size="display" />Contact</h2>
      <div class="home-contact__body">
        <p class="t-body">制作のご依頼、PR、コラボレーション、作品の利用について、企業・アーティストの方からのお問い合わせを受け付けています。</p>
        <p><a class="pill t-label" href="/contact/">お問い合わせ</a></p>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ---------- HERO ----------
     The lockup sticker on this site's paper, under this site's header (the header floats over the hero).
     Taken over from the wakabayashi site (neonni-site-wakabayashi/src/styles/site.css, 2026-11-12):
       the page opens: rings spread round the head, the outlines run from the top, then the white backing and the
       black fill come in on a slant (18deg, the slant of the logo) and the outlines fade; the words rise last.
     2026-11-13 (the user):
       - the lockup opens whole, the logo in view (no close-up on the face)
       - scroll: the stage stays while the first 80svh scrolls by, and the lockup keeps getting smaller until the
         hero has left the screen; meanwhile the ground turns from paper to mist (the Works ground), so the two
         sections meet without an edge, and the rings fade
       - the rings beat after the opening: a double beat runs from the centre ring outwards every 2.4s; the rings
         stay ink-sub and only spread
       - flicker: nothing with fine lines is scaled as a composited layer any more (the rings' own layer is never
         scaled). The rings used to be scaled with
         the scroll; a composited layer of 1px rings is redrawn at a new scale now and then, and the lines visibly
         jumped between soft and sharp. The rings now only fade; the lockup keeps one raster (will-change) and only
         gets smaller than it was drawn.
     Without scroll-driven animations the hero is one screen, its foot fading into mist; with reduced motion nothing
     moves. */
  .hero { position: relative; margin-top: calc(var(--header-h) * -1); overflow-x: clip;
    /* the lockup (2650 : 2580) fills the height between the header and the foot; the SNS column on the right has
       room on TB / PC */
    --lk-w: min(calc(100vw - (var(--grid-margin) + 48px + var(--space-3)) * 2), calc((100svh - var(--header-h) - var(--space-5)) * 1.027));
    /* phones: the height the browser's bars give back when they shrink on scroll (0 on PC) */
    --hero-extra: calc(100lvh - 100svh); }
  /* the stage is as tall as the screen with the bars shrunk (100lvh), so its ground still fills the screen then; the
     lockup, the words and the icons keep to the screen with the bars out (100svh): the extra height is padding at the
     foot (2026-11-13, the user: on a phone a band of the white page showed under the hero while scrolling) */
  .hero__stage { position: relative; isolation: isolate; display: grid; place-items: center; height: 100lvh; min-height: 600px;
    padding: var(--header-h) 0 calc(var(--hero-extra) + var(--space-3)); overflow: hidden; }
  /* the mist that the hero turns into (over the rings, under the lockup) */
  .hero__wall { position: absolute; inset: 0; z-index: -1; background-color: var(--color-mist);
    background-image: var(--grain-light); background-size: 256px 256px; background-attachment: fixed;
    -webkit-mask-image: linear-gradient(transparent 56%, var(--color-ink)); mask-image: linear-gradient(transparent 56%, var(--color-ink)); }
  .hero__lockup { position: relative; width: var(--lk-w); }
  /* the rings sit round the head (40% down the lockup) and do not get smaller with it */
  /* will-change: the rings get a layer of their own (never scaled: only the circles inside move, redrawn sharp). In
     Chrome with the GPU on a Retina Mac, the rings drawn into the page's own layer made the browser show frames with
     parts of the lockup not drawn yet (blank tiles, the outlines only), several times a second while the hero
     opened, beat and scrolled: the flicker on PC (2026-11-13). With their own layer: no such frames. */
  .hero__rings { position: absolute; z-index: -2; left: 50%; top: 40%; width: max(150vw, 150svh); aspect-ratio: 1; translate: -50% -50%; pointer-events: none;
    will-change: transform; }
  .hero__rings circle { fill: none; stroke: var(--color-ink-sub); stroke-width: 1px; vector-effect: non-scaling-stroke;
    transform-box: fill-box; transform-origin: center; }
  .hero__sticker { position: relative; }
  .hero :global(.lockup) { display: block; width: 100%; height: auto; overflow: visible; }
  .hero :global(.lk-shadow) { fill: var(--sticker-shadow); }
  .hero :global(.lk-back) { fill: var(--color-paper); }
  .hero :global(.lk-ink) { fill: var(--color-ink); }
  .hero :global(.lk-lines path) { fill: none; stroke: var(--color-ink); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; opacity: 0; visibility: hidden; }
  .hero__tag { position: absolute; bottom: calc(var(--hero-extra) + var(--space-4)); margin: 0; }
  .hero__tag--bl { left: var(--grid-margin); }
  .hero__tag--br { right: var(--grid-margin); }
  /* SNS: a column at the right edge, in the middle (TB / PC); the icon's drawing lines up with the margin */
  .hero :global(.hero__sns) { position: absolute; right: calc(var(--grid-margin) - var(--space-1) * 3); top: calc((100% - var(--hero-extra)) / 2); translate: 0 -50%;
    flex-direction: column; flex-wrap: nowrap; }
  /* PC: the column is in the header and follows the page (base.css "header") */
  @media (min-width: 1200px) {
    .hero :global(.hero__sns) { display: none; }
  }
  /* SP: a row at the foot on the right, over the name */
  @media (max-width: 767px) {
    .hero { --lk-w: min(calc(100vw - var(--grid-margin) * 2), calc((100svh - var(--header-h) - var(--space-5)) * 1.027)); }
    .hero :global(.hero__sns) { top: auto; bottom: calc(var(--hero-extra) + var(--space-4) + var(--lh-grotesk-data) + var(--space-2)); translate: none; flex-direction: row; }
  }

  /* the page opens */
  @media (prefers-reduced-motion: no-preference) {
    .hero__rings circle { animation: hero-ring-in 1.5s var(--ease-sticker) calc(.25s + var(--i) * 70ms) both,
      hero-ring-beat 2.4s linear calc(3.2s + var(--i) * 90ms) infinite; }
    /* the outlines run, the upper ones first, and go once the fill is in */
    .hero :global(.lk-lines path) { opacity: 1; visibility: visible; stroke-dasharray: 1 1; stroke-dashoffset: 1;
      animation: hero-draw 1.25s cubic-bezier(.55, 0, .2, 1) calc(.35s + var(--t) * .55s) both, hero-out .3s linear 2.35s forwards; }
    /* the backing and the fill come in on a slant (no clip left once in) */
    .hero :global(.lk-fill) { animation: hero-fill 1s var(--ease-sticker) 1.3s backwards; }
    .hero__tag { animation: hero-rise .9s var(--ease-sticker) 1.8s both; }
    .hero :global(.hero__sns li) { animation: hero-rise .9s var(--ease-sticker) 1.9s both; }
    .hero :global(.hero__sns li:nth-child(2)) { animation-delay: 1.97s; }
    .hero :global(.hero__sns li:nth-child(3)) { animation-delay: 2.04s; }
  }
  @keyframes hero-ring-in { from { opacity: 0; transform: scale(.5); } }
  /* ドクン、ドクン: two beats, the second weaker, then rest. The rings only spread: their colour stays ink-sub
     (2026-11-13, the user: the lines went pale between the beats, and the colour going dark / pale / dark / pale
     in 0.4s, ring after ring, read as flicker) */
  @keyframes hero-ring-beat {
    0%, 22%, 100% { transform: none; }
    6% { transform: scale(1.02); }
    12% { transform: scale(1.004); }
    16% { transform: scale(1.012); }
  }
  @keyframes hero-draw { to { stroke-dashoffset: 0; } }
  @keyframes hero-out { to { opacity: 0; visibility: hidden; } }
  @keyframes hero-fill {
    from { clip-path: polygon(-30% 0, -30% 0, -60% 100%, -60% 100%); }
    to { clip-path: polygon(-30% 0, 150% 0, 120% 100%, -60% 100%); }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(12px); } }

  /* scroll (browsers with scroll-driven animations only) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero { height: 180svh; view-timeline: --hero block; }
      .hero__stage { position: sticky; top: 0; }
      .hero__wall { -webkit-mask-image: none; mask-image: none; animation: hero-mist linear both; }
      .hero__sticker { will-change: transform; animation: hero-shrink linear both; }
      /* animation-timeline sits in a rule of its own: the CSS minifier folds it into the animation shorthand above,
         which browsers reject, dropping the motion (found on the wakabayashi site).
         contain 0% = the top of the page; contain 100% = the stage lets go; exit 100% = the hero has left */
      .hero .hero__stage .hero__wall { animation-timeline: --hero; animation-range: contain 0% contain 100%; }
      .hero .hero__stage .hero__sticker { animation-timeline: --hero; animation-range: contain 0% exit 100%; }
    }
  }
  @keyframes hero-mist { from { opacity: 0; } }
  @keyframes hero-shrink { to { transform: scale(.44); } }

  /* ---------- WORKS ---------- */
  .home-works__head { row-gap: var(--space-4); margin-bottom: var(--block-gap); align-items: end; }
  .home-works__title { grid-column: 1 / -1; }
  @media (min-width: 1200px) {
    .home-works__title { grid-column: 1 / span 6; }
  }
  .looks { display: grid; row-gap: var(--section-gap); margin-top: var(--section-gap); }
  /* the cable comes in from beyond the right edge, threads behind each work and ends at the link */
  .looks__start { position: absolute; right: calc(var(--grid-margin) * -1 - var(--space-6)); top: calc(var(--block-gap) * -1); width: 1px; height: 1px; }
  /* no ground under the headings and the data: the cable shows behind them (2026-11-09). Where it crosses a letter,
     the letter keeps a 2px gap of the ground round it, as one line passes behind another in the drawings */
  .look :global(.chapter), .look__info, .look__info :global(.go) { -webkit-text-stroke: 4px var(--color-mist); paint-order: stroke fill; }
  /* Safari paints a visited link's stroke with the link's own visited colour, which the parent's stroke leaves at
     the text colour: the label of a work already seen turned into black blobs (2026-11-09). Set it on the link. */
  .look__info :global(.go:visited) { -webkit-text-stroke-color: var(--color-mist); }
  .look__body { margin-top: var(--block-gap); row-gap: var(--space-6); align-items: end; }
  .look__art { display: block; grid-column: 1 / -1; }
  .look__info { grid-column: 1 / -1; display: grid; gap: var(--space-5); align-content: end; }
  .look--c .look__art { margin-right: calc(var(--grid-margin) * -1); }
  /* TB: half and half */
  @media (min-width: 768px) {
    .look--a .look__art { grid-column: 1 / span 4; }
    .look--a .look__info { grid-column: 5 / -1; }
    .look--b .look__art { grid-column: 5 / -1; grid-row: 1; }
    .look--b .look__info { grid-column: 1 / span 4; grid-row: 1; }
    .look--c .look__art { grid-column: 5 / -1; }
    .look--c .look__info { grid-column: 1 / span 4; grid-row: 1; }
  }
  @media (min-width: 1200px) {
    .look--a .look__art { grid-column: 2 / span 5; }
    .look--a.is-tall .look__art { grid-column: 2 / span 4; }
    .look--a .look__info { grid-column: 8 / span 4; }
    .look--b .look__art { grid-column: 6 / span 6; }
    .look--b .look__info { grid-column: 1 / span 4; }
    .look--c .look__art { grid-column: 6 / -1; }
    .look--c .look__info { grid-column: 1 / span 5; }
  }
  .home-works__more { display: flex; justify-content: center; }

  /* ---------- ABOUT (night) ---------- */
  .home-about__head { display: flex; align-items: flex-start; gap: var(--space-4); }
  .home-about__body { grid-column: 1 / -1; display: grid; gap: var(--space-5); margin-top: var(--block-gap); justify-items: start; }
  @media (min-width: 768px) { .home-about__body { grid-column: 3 / -1; } }
  @media (min-width: 1200px) { .home-about__body { grid-column: 5 / span 7; } }

  /* ---------- CONTACT ---------- */
  .home-contact__grid { row-gap: var(--space-5); align-items: end; }
  .home-contact__title { grid-column: 1 / -1; }
  .home-contact__body { grid-column: 1 / -1; display: grid; gap: var(--space-5); justify-items: start; }
  @media (min-width: 768px) {
    .home-contact__body { grid-column: 4 / -1; }
  }
  @media (min-width: 1200px) {
    .home-contact__title { grid-column: 1 / span 6; }
    .home-contact__body { grid-column: 8 / span 4; }
  }
</style>
