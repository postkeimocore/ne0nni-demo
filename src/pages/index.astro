---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Lockup from '../components/Lockup.astro';
import WorkList from '../components/WorkList.astro';
import Chapter from '../components/Chapter.astro';
import WorkData from '../components/WorkData.astro';
import Go from '../components/Go.astro';
import Icon from '../components/Icon.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { getSite, getWorks, KIND_LABEL, label, pathOf } from '../lib/cms';
import { ACCOUNTS } from '../lib/sns';

const site = await getSite();
const { hero, latest } = site;
const works = await getWorks();
const tall = (w: (typeof latest)[number]) => w.key.height / w.key.width > 1.5;
// the hero's wall pattern: rings round the head (radii in the rings' own units)
const RINGS = Array.from({ length: 10 }, (_, i) => 96 + i * 82);
// the HOME chapters take turns: art left / art right / the cutout bleeding off the right edge
const LOOKS = ['a', 'b', 'c'] as const;

const url = Astro.site!.href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'NE0NNi*', alternateName: 'ネオンニ', url, inLanguage: 'ja' },
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'NE0NNi*', alternateName: 'ネオンニ', url,
    logo: new URL('/assets/logo.svg', url).href, sameAs: ACCOUNTS.map((a) => a.url),
  },
];
---
<Base description={site.description} home jsonLd={jsonLd}>

  <!-- HERO: the NE0NNi* lockup stuck on the page like a sticker. Its look and motion come from the wakabayashi site
       (2026-11-12); the ground, the header and the type are this site's (design-system.md 5 ヒーロー) -->
  <section class="cover hero" aria-labelledby="home-h">
    <div class="hero__stage">
      <div class="hero__wall" aria-hidden="true">
        <svg class="hero__rings" viewBox="-900 -900 1800 1800">
          {RINGS.map((r, i) => <circle r={r} style={`--i:${i}`} />)}
        </svg>
      </div>
      <h1 class="u-sr" id="home-h">NE0NNi*（ネオンニ） Girls &amp; night sounds.</h1>
      <div class="hero__lockup"><Lockup /></div>
      <p class="hero__tag hero__tag--tl t-grotesk-data">{hero.series.name.toUpperCase()}</p>
      <p class="hero__tag hero__tag--bl t-grotesk-data">Girls &amp; night sounds.</p>
      <p class="hero__tag hero__tag--br" lang="ja" aria-hidden="true">ネ　オ　ン　ニ</p>
    </div>
  </section>

  <!-- WORKS: the newest three works as chapters, in order of number, threaded on one cable (4-2) -->
  <section class="l-section l-mist l-container home-works" aria-labelledby="works-h" data-glints="day">
    <div class="home-works__head l-grid">
      <h2 class="t-display-2 home-works__title with-icon with-icon--display" id="works-h"><Icon topic="works" size="display" />Works</h2>
    </div>

    <!-- every work: the newest large, the rest in two columns (arrangement from the wakabayashi site, cards this site's) -->
    <WorkList works={works} />

    <div class="looks" data-cable>
      <span class="looks__start" data-cable-point="center" aria-hidden="true"></span>
      {latest.map((w, i) => {
        const look = LOOKS[i % LOOKS.length];
        const useCut = look === 'c' && w.cut;
        return (
          <article class:list={['look', `look--${look}`, tall(w) && 'is-tall']} aria-labelledby={`look-${w.id}`}>
            <Chapter no={label(w)} title={w.series.name} id={`look-${w.id}`} tag="h3">
              <span class="t-label">{KIND_LABEL[w.kind]}</span>
            </Chapter>
            <div class="look__body l-grid">
              <a class="look__art" href={pathOf(w)} tabindex="-1" aria-hidden="true" data-cable-point="center">
                {useCut
                  ? <Art img={w.cut!} sizes="(min-width: 1200px) 60vw, (min-width: 768px) 75vw, 100vw" decorative />
                  : <div class="stack" data-stack style={`aspect-ratio:${w.key.width}/${w.key.height}`}>
                      <Art img={w.key} sizes={tall(w) ? '(min-width: 1200px) 33vw, (min-width: 768px) 45vw, 100vw' : '(min-width: 1200px) 50vw, (min-width: 768px) 60vw, 100vw'} decorative />
                    </div>}
              </a>
              <div class="look__info" data-reveal="up">
                <WorkData work={w} />
                <Go href={pathOf(w)} label={`View ${label(w)}`} />
              </div>
            </div>
          </article>
        );
      })}
      <p class="home-works__more" data-cable-point="top">
        <Go href="/works/" label="View all works" />
      </p>
    </div>
  </section>

  <!-- ABOUT: the one black section of HOME (Wedding MESSAGE) -->
  <section class="l-section l-container is-night home-about" aria-labelledby="about-h" data-glints="night">
    <div class="home-about__head">
      <h2 class="t-display-1" id="about-h" data-reveal="chars">About</h2>
      <span class="ast is-twinkle" style="--size:40px" aria-hidden="true"></span>
    </div>
    <div class="l-grid">
      <div class="home-about__body">
        <p class="t-display-3">Girls &amp; night sounds.</p>
        <p class="t-statement">音楽を聴く女の子を描く<br>イラストレーション。</p>
        <p class="t-body">NE0NNi*（ネオンニ）は、人物と表情、装い、音楽を聴いている時間を描いています。シリーズ HEADPHONES GIRL では、作品ごとに、キャラクターと曲、描いたヘッドホンなどのギアを記録しています。</p>
        <SnsIcons handles />
        <Go href="/about/" label="About NE0NNi*" />
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="l-section l-container home-contact" aria-labelledby="contact-h">
    <div class="l-grid home-contact__grid">
      <h2 class="t-display-2 home-contact__title with-icon with-icon--display" id="contact-h"><Icon topic="contact" size="display" />Contact</h2>
      <div class="home-contact__body">
        <p class="t-body">制作のご依頼、PR、コラボレーション、作品の利用について、企業・アーティストの方からのお問い合わせを受け付けています。</p>
        <p><a class="pill t-label" href="/contact/">お問い合わせ</a></p>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ---------- HERO ----------
     The lockup sticker on this site's paper, under this site's header (the header floats over the hero).
     Taken over from the wakabayashi site (neonni-site-wakabayashi/src/styles/site.css, 2026-11-12):
       the page opens: rings spread round the head, the outlines run from the top, then the white backing and the
       black fill come in on a slant (18deg, the slant of the logo) and the outlines fade; the words rise last.
       scroll: the stage stays while the first 80vh scrolls by, and the lockup goes from close on the face to whole.
     Without scroll-driven animations the whole lockup shows from the start; with reduced motion nothing moves. */
  .hero { position: relative; margin-top: calc(var(--header-h) * -1); overflow-x: clip; --hero-zoom: 1.6; }
  .hero__stage { position: relative; display: grid; place-items: center; height: 100svh; min-height: 600px; overflow: hidden; }
  .hero__wall { position: absolute; inset: 0; }
  .hero__rings { position: absolute; left: 50%; top: 47%; width: max(150vw, 150svh); aspect-ratio: 1; translate: -50% -50%; }
  .hero__rings circle { fill: none; stroke: var(--color-rule-soft); stroke-width: 1px; vector-effect: non-scaling-stroke;
    transform-box: fill-box; transform-origin: center; }
  /* the lockup is 2650 : 2580: as wide as the screen leaves room for the header and the words below */
  .hero__lockup { position: relative; width: min(84vw, calc((100svh - 168px) * 1.027)); margin-top: var(--space-5);
    transform-origin: 50% 48%; /* the eyes */ }
  .hero :global(.lockup) { display: block; width: 100%; height: auto; overflow: visible; }
  .hero :global(.lk-shadow) { fill: var(--sticker-shadow); }
  .hero :global(.lk-back) { fill: var(--color-paper); }
  .hero :global(.lk-ink) { fill: var(--color-ink); }
  .hero :global(.lk-lines path) { fill: none; stroke: var(--color-ink); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .hero__tag { position: absolute; margin: 0; }
  .hero__tag--tl { top: calc(var(--header-h) + var(--space-3)); left: var(--grid-margin); }
  .hero__tag--bl { bottom: var(--space-4); left: var(--grid-margin); }
  .hero__tag--br { bottom: var(--space-4); right: var(--grid-margin);
    font: 500 var(--fs-grotesk-data)/var(--lh-grotesk-data) var(--font-gothic); letter-spacing: var(--ls-ja-display); }
  @media (max-width: 767px) {
    .hero { --hero-zoom: 1.1; } /* 90vw x 1.1 = 99vw: close on the face without the lockup leaving the screen */
    .hero__lockup { width: min(90vw, calc((100svh - 200px) * 1.027)); margin-top: 0; }
  }

  /* the page opens */
  @media (prefers-reduced-motion: no-preference) {
    .hero__wall { animation: hero-wall-in 1.1s var(--ease-sticker) both; }
    .hero__rings circle { animation: hero-ring-in 1.5s var(--ease-sticker) calc(.25s + var(--i) * 70ms) both; }
    /* the outlines run, the upper ones first */
    .hero :global(.lk-lines path) { opacity: 1; stroke-dasharray: 1 1; stroke-dashoffset: 1;
      animation: hero-draw 1.25s cubic-bezier(.55, 0, .2, 1) calc(.35s + var(--t) * .55s) both, hero-out .3s linear 2.35s forwards; }
    /* the backing and the fill come in on a slant */
    .hero :global(.lk-fill) { animation: hero-fill 1s var(--ease-sticker) 1.3s both; }
    .hero__tag { animation: hero-rise .9s var(--ease-sticker) 1.8s both; }
  }
  @keyframes hero-wall-in {
    from { clip-path: polygon(0 0, 0 0, -40% 100%, -40% 100%); }
    to { clip-path: polygon(0 0, 140% 0, 100% 100%, -40% 100%); }
  }
  @keyframes hero-ring-in { from { opacity: 0; transform: scale(.5); } }
  @keyframes hero-draw { to { stroke-dashoffset: 0; } }
  @keyframes hero-out { to { opacity: 0; } }
  @keyframes hero-fill {
    from { clip-path: polygon(-30% 0, -30% 0, -60% 100%, -60% 100%); }
    to { clip-path: polygon(-30% 0, 150% 0, 120% 100%, -60% 100%); }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(12px); } }

  /* scroll: close on the face -> the whole lockup (browsers with scroll-driven animations only) */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero { height: 180svh; }
      .hero__stage { position: sticky; top: 0; }
      .hero__lockup { animation: hero-assemble linear both; }
      .hero__rings { animation: hero-rings-turn linear both; }
      /* animation-timeline sits in a rule of its own: the CSS minifier folds it into the animation shorthand above
         as "animation: ... scroll(root)", which browsers reject, dropping the motion (found on the wakabayashi site) */
      .hero .hero__stage .hero__lockup, .hero .hero__stage .hero__rings { animation-timeline: scroll(root block); animation-range: 0 80vh; }
    }
  }
  @keyframes hero-assemble { from { transform: scale(var(--hero-zoom)); } to { transform: none; } }
  @keyframes hero-rings-turn { from { transform: scale(1.4) rotate(-16deg); } to { transform: none; } }

  /* ---------- WORKS ---------- */
  .home-works__head { row-gap: var(--space-4); margin-bottom: var(--block-gap); align-items: end; }
  .home-works__title { grid-column: 1 / -1; }
  @media (min-width: 1200px) {
    .home-works__title { grid-column: 1 / span 6; }
  }
  .looks { display: grid; row-gap: var(--section-gap); margin-top: var(--section-gap); }
  /* the cable comes in from beyond the right edge, threads behind each work and ends at the link */
  .looks__start { position: absolute; right: calc(var(--grid-margin) * -1 - var(--space-6)); top: calc(var(--block-gap) * -1); width: 1px; height: 1px; }
  /* no ground under the headings and the data: the cable shows behind them (2026-11-09). Where it crosses a letter,
     the letter keeps a 2px gap of the ground round it, as one line passes behind another in the drawings */
  .look :global(.chapter), .look__info, .look__info :global(.go) { -webkit-text-stroke: 4px var(--color-mist); paint-order: stroke fill; }
  /* Safari paints a visited link's stroke with the link's own visited colour, which the parent's stroke leaves at
     the text colour: the label of a work already seen turned into black blobs (2026-11-09). Set it on the link. */
  .look__info :global(.go:visited) { -webkit-text-stroke-color: var(--color-mist); }
  .look__body { margin-top: var(--block-gap); row-gap: var(--space-6); align-items: end; }
  .look__art { display: block; grid-column: 1 / -1; }
  .look__info { grid-column: 1 / -1; display: grid; gap: var(--space-5); align-content: end; }
  .look--c .look__art { margin-right: calc(var(--grid-margin) * -1); }
  /* TB: half and half */
  @media (min-width: 768px) {
    .look--a .look__art { grid-column: 1 / span 4; }
    .look--a .look__info { grid-column: 5 / -1; }
    .look--b .look__art { grid-column: 5 / -1; grid-row: 1; }
    .look--b .look__info { grid-column: 1 / span 4; grid-row: 1; }
    .look--c .look__art { grid-column: 5 / -1; }
    .look--c .look__info { grid-column: 1 / span 4; grid-row: 1; }
  }
  @media (min-width: 1200px) {
    .look--a .look__art { grid-column: 2 / span 5; }
    .look--a.is-tall .look__art { grid-column: 2 / span 4; }
    .look--a .look__info { grid-column: 8 / span 4; }
    .look--b .look__art { grid-column: 6 / span 6; }
    .look--b .look__info { grid-column: 1 / span 4; }
    .look--c .look__art { grid-column: 6 / -1; }
    .look--c .look__info { grid-column: 1 / span 5; }
  }
  .home-works__more { display: flex; justify-content: center; }

  /* ---------- ABOUT (night) ---------- */
  .home-about__head { display: flex; align-items: flex-start; gap: var(--space-4); }
  .home-about__body { grid-column: 1 / -1; display: grid; gap: var(--space-5); margin-top: var(--block-gap); justify-items: start; }
  @media (min-width: 768px) { .home-about__body { grid-column: 3 / -1; } }
  @media (min-width: 1200px) { .home-about__body { grid-column: 5 / span 7; } }

  /* ---------- CONTACT ---------- */
  .home-contact__grid { row-gap: var(--space-5); align-items: end; }
  .home-contact__title { grid-column: 1 / -1; }
  .home-contact__body { grid-column: 1 / -1; display: grid; gap: var(--space-5); justify-items: start; }
  @media (min-width: 768px) {
    .home-contact__body { grid-column: 4 / -1; }
  }
  @media (min-width: 1200px) {
    .home-contact__title { grid-column: 1 / span 6; }
    .home-contact__body { grid-column: 8 / span 4; }
  }
</style>
