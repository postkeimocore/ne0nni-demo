---
/**
 * The works list on HOME, between the Works heading and the chapters. The arrangement comes from the wakabayashi site
 * (2026-11-12); the look is this site's (2026-11-13, the user: match the site's tone, do not bring it in as it was).
 *   - the newest work large on the left, staying while the list scrolls by (phones and portrait tablets: first)
 *   - the rest in two columns, newest first, the right column 48px lower (as `pair` on WORKS)
 * Cards: src/components/WorkTile.astro. Look: base.css "works list".
 */
import WorkTile from './WorkTile.astro';
import type { Work } from '../lib/types';

interface Props { works: Work[] }
const [feature, ...rest] = [...Astro.props.works].sort((a, b) => b.no - a.no);
const tall = feature ? feature.key.height / feature.key.width > 1.5 : false;
---
{feature && (
  <div class="wl">
    <div class="wl__feature" data-shape={tall ? 'tall' : 'portrait'}><WorkTile work={feature} big /></div>
    {rest.length > 0 && (
      <ul class="wl__list">
        {rest.map((w) => <li><WorkTile work={w} /></li>)}
      </ul>
    )}
  </div>
)}
