---
import SnsIcons from './SnsIcons.astro';
interface Props { home?: boolean; current?: 'works' | 'about' | 'contact' }
const { home = false, current } = Astro.props;
const NAV = [
  { id: 'works', href: '/works/', label: 'Works' },
  { id: 'about', href: '/about/', label: 'About' },
  { id: 'contact', href: '/contact/', label: 'Contact' },
] as const;
---
<svg class="edge-defs" width="0" height="0" aria-hidden="true" focusable="false"><filter id="edge-line" x="-10%" y="-40%" width="120%" height="180%" color-interpolation-filters="sRGB"><feMorphology in="SourceAlpha" operator="dilate" radius="3" result="out"/><feMorphology in="SourceAlpha" operator="dilate" radius="2" result="in"/><feComposite in="out" in2="in" operator="out" result="ring"/><feFlood flood-color="#fff"/><feComposite in2="ring" operator="in"/></filter></svg>
<header class="site-header">
  <a class="site-header__home" href="/" aria-label="NE0NNi* ホーム"><span class="logo" aria-hidden="true"></span></a>
  <nav class="site-nav t-label" aria-label="メイン">
    {NAV.map((n) => <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <button class="menu-btn" type="button" aria-label="メニュー" aria-expanded="false" aria-controls="menu" data-menu-open><span></span></button>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="メニュー" hidden>
  <div class="menu__bar">
    <a href="/" aria-label="NE0NNi* ホーム"><span class="logo" aria-hidden="true"></span></a>
    <button class="menu__close" type="button" aria-label="メニューを閉じる" data-menu-close><span></span></button>
  </div>
  <nav class="menu__nav" aria-label="メイン">
    {NAV.map((n) => <a class="t-grotesk-display" href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <div class="menu__foot">
    <p class="t-grotesk-data">Girls &amp; night sounds.</p>
    <SnsIcons />
  </div>
</div>
