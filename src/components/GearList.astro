---
/** Gear list (GLOBAL WORK item list): 64px thumbnail, brand / model, a link to the works with the same gear. */
import type { Gear } from '../lib/types';
import { filterKey } from '../lib/cms';
import Art from './Art.astro';
interface Props { gear: Gear[]; counts?: Record<string, number>; link?: boolean }
const { gear, counts = {}, link = true } = Astro.props;
---
<ul class="data-list">
  {gear.map((g) => (
    <li class="data-item">
      {g.thumb ? <Art img={g.thumb} sizes="64px" class="data-item__thumb" decorative /> : <span class="data-item__thumb data-item__thumb--type" aria-hidden="true" />}
      <div class="data-item__body">
        <dl class="t-grotesk-data"><dt class="t-label">Brand</dt><dd>{g.brand}</dd><dt class="t-label">Model</dt><dd>{g.model}</dd></dl>
        {link && (
          <a class="link t-label" href={`/works/?f=${filterKey.gear(g)}`}>
            {g.brand} {g.model} の作品{counts[g.id] ? `（${counts[g.id]}）` : ''}
          </a>
        )}
      </div>
    </li>
  ))}
</ul>
