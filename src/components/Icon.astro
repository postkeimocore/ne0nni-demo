---
/**
 * A NE0NNi* icon, drawn inline so its colors come from tokens.css (design-system.md 4-9).
 * Decorative: the words next to it say the same thing. night: the version drawn for black grounds.
 * Path data: src/lib/icons.ts (scripts/make-icons.py from ../SNS/icons/svg).
 */
import { ICONS, type IconName } from '../lib/icons';
interface Props { name: IconName; night?: boolean; class?: string }
const { name, night = false, class: cls } = Astro.props;
const s = ICONS[name][night ? 'night' : 'day'];
const [x, y, w, h] = s.box;
---
<svg class:list={['icon', night && 'icon--night', cls]} viewBox={`${x} ${y} ${w} ${h}`} style={`aspect-ratio: ${w} / ${h}`} aria-hidden="true" focusable="false">
  <path class="icon__fill" d={s.fill} />
  <path class="icon__ink" d={s.ink} />
</svg>
