---
/**
 * One work in the HOME works list (src/components/WorkList.astro), set like the cards on WORKS:
 * the picture (4:5, or whole when the large one is tall), then the number, the series and the kind. The card goes to
 * the work's page. It rises in with the other blocks (data-reveal="up").
 */
import Art from './Art.astro';
import { KIND_LABEL, label, pathOf } from '../lib/cms';
import type { Work } from '../lib/types';

interface Props {
  work: Work;
  /** the large one on the left: the picture whole when it is tall (9:16), otherwise 4:5 like the rest */
  big?: boolean;
}
const { work: w, big = false } = Astro.props;
const tall = big && w.key.height / w.key.width > 1.5;
const sizes = big ? '(min-width: 1200px) 40vw, (min-width: 768px) 50vw, 100vw' : '(min-width: 1200px) 24vw, 50vw';
---
<article class="wtile" data-shape={tall ? 'tall' : 'portrait'} data-reveal="up">
  <a class="wtile__link" href={pathOf(w)}>
    <div class="wtile__art">
      <Art img={w.key} sizes={sizes} style={w.focus && !tall ? `object-position:${w.focus}` : undefined} />
    </div>
    <div class="wtile__cap">
      <span class="t-number">{label(w)}</span>
      <span class="t-grotesk-title">{w.series.name}</span>
      <span class="t-label wtile__kind">{KIND_LABEL[w.kind]}</span>
    </div>
  </a>
</article>
