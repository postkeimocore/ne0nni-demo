---
/**
 * SNS posts of a work: short videos (9:16) and photo posts (4:5) at the same height, in the one rounded frame
 * of the page. The video or photo plays in our own frame; under it, the play button and an icon for each
 * platform the post is on (design-system.md 5, "SNS投稿の取り込み").
 * TikTok's Embed Player was tried and dropped: it always shows the account bar and the like counts.
 */
import { getImage } from 'astro:assets';
import type { Post } from '../lib/types';
import Art from './Art.astro';
import SnsIcon from './SnsIcon.astro';
interface Props { posts: Post[] }
const { posts } = Astro.props;
// poster frames for the videos, resized like any other image
const posters = await Promise.all(posts.map((p) =>
  p.kind === 'short' && p.video && p.image ? getImage({ src: p.image.src, width: 720, format: 'webp', quality: 82, ...(typeof p.image.src === 'string' ? { height: Math.round(720 * p.image.height / p.image.width) } : {}) }) : undefined));
---
<div class="posts">
  <ul class="posts__list">
    {posts.map((p, i) => (
      <li class="post">
        <div class:list={['post__media', p.kind === 'short' ? 'post__media--short' : 'post__media--photo']}>
          {p.kind === 'short' && p.video
            ? <video src={p.video} poster={posters[i]?.src} muted loop playsinline preload="none" aria-label={p.image?.alt} />
            : p.image && <Art img={p.image} sizes="(min-width: 1200px) 448px, (min-width: 768px) 384px, 320px" />}
        </div>
        <div class="post__meta">
          <span class="post__ctrl">
            {p.kind === 'short' && p.video && <button class="post__play" type="button" aria-label="動画を再生"><span></span></button>}
            <span class="t-label">{p.kind === 'short' ? 'Short' : 'Photo'}</span>
          </span>
          {p.links.length > 0 && (
            <span class="post__links">{p.links.map((l) => <SnsIcon platform={l.platform} href={l.url} post />)}</span>
          )}
        </div>
      </li>
    ))}
  </ul>
</div>
