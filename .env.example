# microCMS (leave empty to build with src/data/works.ts)
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Search engines: keep "false" until launch (adds noindex meta + X-Robots-Tag)
PUBLIC_ALLOW_INDEX=false

# Canonical site URL (set the custom domain at launch)
SITE_URL=https://ne0nni-demo.pages.dev

# Turnstile site key (the secret goes to the Pages Function as TURNSTILE_SECRET)
PUBLIC_TURNSTILE_SITE_KEY=
